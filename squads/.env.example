# OpenSquad — Environment Variables (Template)
# Copie este arquivo para .env e preencha as chaves reais. Nunca comite o .env!

# ── Image AI Generator ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=sua_chave_aqui

# ── LinkedIn CLI ─────────────────────────────────────────────────────────────
LINKED_API_TOKEN=sua_chave_aqui
IDENTIFICATION_TOKEN=seu_id_aqui

# ── GitHub API ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=sua_chave_github_aqui

# ── Email Sender ─────────────────────────────────────────────────────────────
RESEND_API_KEY=sua_chave_resend_aqui

# ── Telegram Bridge ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui

# ── LLM reserves for employee workflows (server only) ───────────────────────
STAFF_GEMINI_API_KEY=sua_chave_gemini_para_funcionarios_aqui
STAFF_OPENAI_API_KEY=sua_chave_openai_para_funcionarios_aqui
STAFF_ANTHROPIC_API_KEY=sua_chave_anthropic_para_funcionarios_aqui

# ── Stripe Webhook ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sua_chave_stripe_aqui
