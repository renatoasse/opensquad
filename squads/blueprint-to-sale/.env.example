# Blueprint-to-Sale Squad — Environment Variables
# Copy this to .env and fill in the values

# GitHub Personal Access Token (repo creation + collaborator management)
GITHUB_PAT=your_github_personal_access_token_here
GITHUB_OWNER=alinebuilds2503

# Firebase Project
FIREBASE_PROJECT_ID=your-project-id
FIRESTORE_COLLECTION=blueprints

# Email Sender
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@alinebuilds.com

# Payment - Hotmart
HOTMART_WEBHOOK_SECRET=hct_xxxxxxxxxxxxxxxxxxxx
PAYMENT_LINK_BASE=https://pay.hotmart.com/
