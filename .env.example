# Copy this file to .env and fill in only the keys for the skills you use.
# Each skill lists the variables it needs in the `env:` field of its SKILL.md.
# Never commit .env (it is gitignored).

# --- instagram-publisher ---
# Instagram Graph API — https://developers.facebook.com/docs/instagram-api/
# Requires an Instagram Business account connected to a Facebook Page.
# Get your token from: Meta for Developers → Graph API Explorer
# Required scope: instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_user_id_here

# Image hosting (imgBB) — https://api.imgbb.com/
# Required for instagram-publisher. Get a free API key at https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here

# --- image-ai-generator ---
# Openrouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- apify ---
# Apify — https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# --- blotato ---
# Blotato — https://my.blotato.com/settings (API section)
BLOTATO_API_KEY=your_blotato_api_key_here

# --- resend ---
# Resend — https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
